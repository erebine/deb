#!/bin/sh
# SPDX-License-Identifier: MIT
set -e

# Removes the obsolete xem-agent.env; see preinst.
dpkg-maintscript-helper rm_conffile /etc/erebine/xem-agent.env 2.4.0~ \
    erebine-eem-agent -- "$@"

if [ "$1" = "configure" ]; then
    if ! getent passwd erebine >/dev/null; then
        adduser --system --group --home /var/lib/erebine \
            --no-create-home --quiet erebine
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
fi
