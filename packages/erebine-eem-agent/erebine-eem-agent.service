# SPDX-License-Identifier: MIT
# Erebine - EEM Agent systemd unit (installed by the erebine-eem-agent
# package). Configure /etc/erebine/eem-agent.env, then:
#   sudo systemctl enable --now erebine-eem-agent

[Unit]
Description=Erebine EEM Agent
Documentation=https://erebine.ai/docs/private-agents
After=network-online.target
Wants=network-online.target

# Start rate limit. These two keys are only honored in [Unit]; a
# StartLimitIntervalSec= placed in [Service] is silently ignored and
# leaves the default 10s window, which RestartSec=5 never fills, so a
# doomed agent restarts forever.
#
# The agent exits non-zero when the join key is absent, expired, or
# already redeemed: the router answers 4xx and enrollment is not
# retried (network and 5xx errors are retried inside the process
# first). A join key allows only a limited number of enrollments, and
# an agent that comes back without its persisted CURVE key re-enrolls
# and spends one. Five starts inside ten minutes therefore trips the
# limit and parks the unit in `failed` until an operator installs a
# fresh join key and runs:
#   sudo systemctl reset-failed erebine-eem-agent
#   sudo systemctl start erebine-eem-agent
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=erebine
Group=erebine

ExecStart=/usr/bin/erebine-eem-agent

# Environment configuration. Nothing is pinned with Environment=: the
# agent reads CLI flags, then the environment, then /etc/erebine/eem.yaml,
# so a pin here would silently override that file for every operator.
# log_level (default info) comes from eem.yaml or that default; the env
# file below, read into the environment, still overrides it.
EnvironmentFile=-/etc/erebine/eem-agent.env

# Runtime directories
RuntimeDirectory=erebine-eem-agent
StateDirectory=erebine

# Restart policy
Restart=on-failure
RestartSec=5

# Resource limits. LimitNPROC is not per service: it caps every process
# and thread of the erebine user on the host, and the EIM agent runs as
# that user too. On a host with both, vLLM's threads count against this
# unit, and once they pass the cap every tool launch here fails with
# EAGAIN. It is uncapped for the same reason as in the EIM unit; the
# per-service cap stays systemd's default TasksMax.
LimitNOFILE=65536
LimitNPROC=infinity

# Security hardening. Tools the agent runs inherit this sandbox: they
# cannot read /home, write outside /var/lib/erebine, or gain privileges.
# Widen it with a drop-in rather than by editing this file, which a
# package upgrade replaces. ReadWritePaths= in a drop-in adds to the list
# below:
#   sudo systemctl edit erebine-eem-agent
#     [Service]
#     ProtectHome=read-only
#     ReadWritePaths=/srv/repos
#   sudo systemctl restart erebine-eem-agent
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/erebine
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
