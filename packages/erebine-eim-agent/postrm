#!/bin/sh
# SPDX-License-Identifier: MIT
set -e

# Removes the obsolete xim-agent.env; see preinst.
dpkg-maintscript-helper rm_conffile /etc/erebine/xim-agent.env 2.3.5~ \
    erebine-eim-agent -- "$@"

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
