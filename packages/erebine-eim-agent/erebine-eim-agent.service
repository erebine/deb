# SPDX-License-Identifier: MIT
# Erebine - EIM Agent systemd unit (installed by the erebine-eim-agent
# package). Set the join key in /etc/erebine/eim-agent.env, then:
#   sudo systemctl enable --now erebine-eim-agent

[Unit]
Description=Erebine EIM Agent
Documentation=https://erebine.ai/docs/private-agents
After=network-online.target
Wants=network-online.target

# Start rate limit. These two keys are only honored in [Unit]; a
# StartLimitIntervalSec= placed in [Service] is silently ignored and
# leaves the default 10s window, which RestartSec=5 never fills, so a
# doomed agent restarts forever.
#
# Until an enrollment is persisted, every start runs `enroll`, which
# tries each router once and exits non-zero when the join key is
# absent, malformed, expired, revoked or used up, or when no router
# answers. Retrying cannot fix a rejected key, and a join key allows
# only a limited number of enrollments, so a loop that does reach the
# router can spend what the key has left. Five starts inside ten
# minutes (about 25 seconds at RestartSec=5) therefore trips the limit
# and parks the unit in `failed` until an operator installs a fresh
# join key and runs:
#   sudo systemctl reset-failed erebine-eim-agent
#   sudo systemctl start erebine-eim-agent
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=erebine
Group=erebine

# The agent persists enrollment under $HOME/.config/erebine.
Environment=HOME=/var/lib/erebine
EnvironmentFile=-/etc/erebine/eim-agent.env

# First start enrolls with EREBINE_AGENT_JOIN_KEY from the env file;
# later starts reuse the persisted enrollment state.
ExecStartPre=/bin/sh -c '[ -f "$HOME/.config/erebine/enrollment.json" ] || /usr/bin/erebine-eim-agent enroll'
ExecStart=/usr/bin/erebine-eim-agent run

# Runtime directories
RuntimeDirectory=erebine-eim-agent
StateDirectory=erebine

# Restart policy
Restart=on-failure
RestartSec=5

# Resource limits. LimitNPROC is not per service: it caps every process
# and thread of the erebine user on the host, the EEM agent's included,
# and vLLM starts many (a worker per GPU, each with NCCL, BLAS and compile
# threads). The container deploys run vLLM with no pids limit after a
# 2048-task cap killed a data-parallel launch before the model loaded, so
# it is not capped here either. The per-service cap stays systemd's
# default TasksMax, a share of the host's thread ceiling (15% on Ubuntu,
# 80% on RHEL; at 15% that is about 157,000 tasks per 128 GiB of RAM),
# far above what vLLM starts, so TasksMax is not raised.
LimitNOFILE=65536
LimitNPROC=infinity
# vLLM and CUDA map very large virtual address ranges, and NCCL over
# InfiniBand or RoCE registers memory against the locked-memory limit,
# which the agent cannot bypass without CAP_IPC_LOCK. systemd's default
# locked-memory limit is 8 MiB on Ubuntu 24.04 and RHEL 9, so neither
# limit is left to the default, as in the unit erectl writes for a
# bare-metal agent.
LimitMEMLOCK=infinity
LimitAS=infinity

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/erebine
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
