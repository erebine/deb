# Environment for erebine-eim-agent.service.
# The join key is required for first-start enrollment; get one from the
# Erebine dashboard.
# EREBINE_AGENT_JOIN_KEY=ejk_your_key_here
# EREBINE_AGENT_LOG_LEVEL=info
#
# This package does not install vLLM; the operator supplies it. Set the
# absolute path of its vllm executable here. A bare name is not looked up
# on PATH: it resolves against the service's working directory, /.
# EREBINE_AGENT_VLLM_PATH=/opt/vllm/bin/vllm
